DATABASE_URL=postgres://postgres:your-password@127.0.0.1:5432/postgres?sslmode=disable
DB_SCHEMA=map-maker-db-new
FRONTEND_ORIGINS=http://localhost:3000,https://map-maker-group.vercel.app,https://map-maker-group-*.vercel.app
PORT=8080

# DEMO_MODE=true       ไม่ต่อฐานข้อมูล ใช้รถจำลองในหน่วยความจำ (DATABASE_URL ว่างก็เข้าโหมดนี้เอง)
# DEMO_FLEET_SIZE=107
# SIMULATE=true        มีฐานข้อมูลแต่ยังไม่มีอุปกรณ์จริง ให้ server ขยับรถที่ออนไลน์ทุก 3 วินาที
